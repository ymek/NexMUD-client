<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TextView remains supported in Terminal.Gui 2.5 but is soft-obsolete in favor of a separate alpha editor package. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NexMud.Client/NexMud.Client.csproj" />
    <ProjectReference Include="../NexMud.Contracts/NexMud.Contracts.csproj" />
    <ProjectReference Include="../NexMud.Jev/NexMud.Jev.csproj" />
  </ItemGroup>
</Project>
